PORT=5001
MONGODB_URI=mongodb+srv://user:password@mongodb.atlas.mongodb.net/telco-ipdr?retryWrites=true&w=majority
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2023-05-15

# LangSmith Tracing (optional)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=telco-ipdr-agent

# MongoDB MCP
MDB_MCP_READ_ONLY=true
MDB_MCP_PORT=5003
MDB_MCP_CONNECTION_STRING=mongodb+srv://user:password@mongodb.atlas.mongodb.net/telco-ipdr

# Voyage AI (embedding model)
VOYAGE_API_KEY=your-voyage-api-key
VOYAGE_API_BASE_URL=https://ai.mongodb.com/v1
